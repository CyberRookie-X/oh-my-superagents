{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "oh-my-superagents supports both the current layered config shape and the legacy single-routing shape during migration.",
  "properties": {
    "workflow": {
      "$ref": "#/$defs/workflow"
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "activePreset": { "type": "string", "minLength": 1 },
        "defaultLane": { "type": ["string", "null"], "minLength": 1 },
        "laneSelection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": ["manual", "suggest", "auto"]
            }
          }
        },
        "commandPrefix": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$" },
        "commands": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$" },
                "aliases": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$" }
                }
              }
            },
            "use": { "$ref": "#/$defs/commandEntry" },
            "disable": { "$ref": "#/$defs/commandEntry" },
            "sync": { "$ref": "#/$defs/commandEntry" },
            "doctor": { "$ref": "#/$defs/commandEntry" }
          }
        },
        "superpowersCompatibility": { "$ref": "#/$defs/compatibility" }
      }
    },
    "presets": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "required": ["label", "short", "routes", "defaultRoute"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "short": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$" },
          "description": { "type": "string", "minLength": 1 },
          "extends": { "type": "string", "minLength": 1 },
          "profiles": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1
            },
            "additionalProperties": {
              "$ref": "#/$defs/profile"
            }
          },
          "usesLanes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "defaultLane": { "type": "string", "minLength": 1 },
          "routes": {
            "$ref": "#/$defs/routes"
          },
          "defaultRoute": { "type": "string", "minLength": 1 }
        }
      }
    },
    "profiles": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/profile"
      }
    },
    "lanes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "required": ["label", "routes", "defaultRoute"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "routes": {
            "$ref": "#/$defs/routes"
          },
          "defaultRoute": { "type": "string", "minLength": 1 }
        }
      }
    },
    "routes": {
      "$ref": "#/$defs/routes"
    },
    "defaultRoute": { "type": "string", "minLength": 1 },
    "superpowersCompatibility": { "$ref": "#/$defs/compatibility" }
  },
  "anyOf": [
    {
      "type": "object",
      "required": ["presets"],
      "additionalProperties": false,
      "properties": {
        "workflow": {
          "$ref": "#/$defs/workflow"
        },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "activePreset": { "type": "string", "minLength": 1 },
            "defaultLane": { "type": ["string", "null"], "minLength": 1 },
            "laneSelection": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "enum": ["manual", "suggest", "auto"]
                }
              }
            },
            "commandPrefix": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$" },
            "commands": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "status": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$" },
                    "aliases": {
                      "type": "array",
                      "items": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$" }
                    }
                  }
                },
                "use": { "$ref": "#/$defs/commandEntry" },
                "disable": { "$ref": "#/$defs/commandEntry" },
                "sync": { "$ref": "#/$defs/commandEntry" },
                "doctor": { "$ref": "#/$defs/commandEntry" }
              }
            },
            "superpowersCompatibility": { "$ref": "#/$defs/compatibility" }
          }
        },
        "profiles": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "object",
            "required": ["model"],
            "additionalProperties": false,
            "properties": {
              "model": { "type": "string", "minLength": 1 },
              "variant": { "type": "string", "minLength": 1 },
              "effort": { "enum": ["fast", "balanced", "deep", "max"] },
              "codexFast": { "type": "boolean" },
              "temperature": { "type": "number" }
            }
          }
        },
        "lanes": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "object",
            "required": ["label", "routes", "defaultRoute"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 },
              "routes": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1
                },
                "additionalProperties": { "type": "string", "minLength": 1 }
              },
              "defaultRoute": { "type": "string", "minLength": 1 }
            }
          }
        },
        "presets": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "object",
            "required": ["label", "short", "routes", "defaultRoute"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "short": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$" },
              "description": { "type": "string", "minLength": 1 },
              "extends": { "type": "string", "minLength": 1 },
              "profiles": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1
                },
                "additionalProperties": {
                  "type": "object",
                  "required": ["model"],
                  "additionalProperties": false,
                  "properties": {
                    "model": { "type": "string", "minLength": 1 },
                    "variant": { "type": "string", "minLength": 1 },
                    "effort": { "enum": ["fast", "balanced", "deep", "max"] },
                    "codexFast": { "type": "boolean" },
                    "temperature": { "type": "number" }
                  }
                }
              },
              "usesLanes": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "defaultLane": { "type": "string", "minLength": 1 },
              "routes": {
                "$ref": "#/$defs/routes"
              },
              "defaultRoute": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["profiles", "defaultRoute"],
      "additionalProperties": false,
      "properties": {
        "workflow": {
          "$ref": "#/$defs/workflow"
        },
        "profiles": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "$ref": "#/$defs/profile"
          }
        },
        "routes": {
          "$ref": "#/$defs/routes"
        },
        "defaultRoute": { "type": "string", "minLength": 1 },
        "superpowersCompatibility": { "$ref": "#/$defs/compatibility" }
      }
    }
  ],
  "$defs": {
    "profile": {
      "type": "object",
      "required": ["model"],
      "additionalProperties": false,
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "variant": { "type": "string", "minLength": 1 },
        "effort": { "enum": ["fast", "balanced", "deep", "max"] },
        "codexFast": { "type": "boolean" },
        "temperature": { "type": "number" }
      }
    },
    "routes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "workflow": {
      "anyOf": [
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "superpowers" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "intents"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "direct" },
            "intents": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z0-9-]+$"
              },
              "additionalProperties": {
                "$ref": "#/$defs/directIntent"
              }
            }
          }
        }
      ]
    },
    "directIntent": {
      "type": "object",
      "required": ["label"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": ["warn", "strict"],
          "default": "warn"
        }
      }
    },
    "commandEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$" },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$" }
        }
      }
    }
  }
}
