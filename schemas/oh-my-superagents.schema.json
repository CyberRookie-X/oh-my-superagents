{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "oh-my-superagents supports both the current layered config shape and the legacy single-routing shape during migration.",
  "properties": {
    "workflow": {
      "$ref": "#/$defs/workflow"
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "activePreset": { "type": "string", "minLength": 1 },
        "defaultLane": { "type": ["string", "null"], "minLength": 1 },
        "laneSelection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": ["manual", "suggest", "auto"]
            }
          }
        },
        "subagentExecution": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": ["manual", "suggest", "auto"],
              "default": "suggest"
            }
          }
        },
        "contextCompression": {
          "$ref": "#/$defs/contextCompression"
        },
        "commandPrefix": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$" },
        "commands": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$" },
                "aliases": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$" }
                }
              }
            },
            "use": { "$ref": "#/$defs/commandEntry" },
            "disable": { "$ref": "#/$defs/commandEntry" },
            "sync": { "$ref": "#/$defs/commandEntry" },
            "doctor": { "$ref": "#/$defs/commandEntry" }
          }
        },
        "superpowersCompatibility": { "$ref": "#/$defs/compatibility" }
      }
    },
    "sourcePresets": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/sourcePreset"
      }
    },
    "compressionPresets": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/compressionPreset"
      }
    },
    "contextProviders": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/contextProvider"
      }
    },
    "authority": {
      "$ref": "#/$defs/authority"
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    },
    "policyRules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/policyRule"
      }
    },
    "presets": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "required": ["label", "short", "routes", "defaultRoute"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "short": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$" },
          "description": { "type": "string", "minLength": 1 },
          "extends": { "type": "string", "minLength": 1 },
          "profiles": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1
            },
            "additionalProperties": {
              "$ref": "#/$defs/profile"
            }
          },
          "usesLanes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "defaultLane": { "type": "string", "minLength": 1 },
          "sourcePreset": { "type": "string", "minLength": 1 },
          "sourceRoutes": {
            "$ref": "#/$defs/sourceRoutes"
          },
          "routes": {
            "$ref": "#/$defs/routes"
          },
          "defaultRoute": { "type": "string", "minLength": 1 }
        }
      }
    },
    "profiles": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/profile"
      }
    },
    "lanes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "required": ["label", "routes", "defaultRoute"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "routes": {
            "$ref": "#/$defs/routes"
          },
          "defaultRoute": { "type": "string", "minLength": 1 }
        }
      }
    },
    "routes": {
      "$ref": "#/$defs/routes"
    },
    "defaultRoute": { "type": "string", "minLength": 1 },
    "superpowersCompatibility": { "$ref": "#/$defs/compatibility" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "workflow": {
            "type": "object",
            "properties": {
              "kind": { "const": "direct" }
            },
            "required": ["kind"]
          }
        }
      },
      "then": {
        "properties": {
          "sourcePresets": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "routes": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "pattern": "^intent\\..+$"
                  },
                  "additionalProperties": {
                    "$ref": "#/$defs/workflowSourceKind"
                  }
                }
              }
            }
          },
          "presets": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "sourceRoutes": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "pattern": "^intent\\..+$"
                  },
                  "additionalProperties": {
                    "$ref": "#/$defs/workflowSourceKind"
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "sourcePresets": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "routes": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "pattern": "^phase\\.(brainstorm|plan|execute|review|verify|visual|web-test)$"
                  },
                  "additionalProperties": {
                    "$ref": "#/$defs/nonDirectWorkflowSourceKind"
                  }
                }
              }
            }
          },
          "presets": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "sourceRoutes": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "pattern": "^phase\\.(brainstorm|plan|execute|review|verify|visual|web-test)$"
                  },
                  "additionalProperties": {
                    "$ref": "#/$defs/nonDirectWorkflowSourceKind"
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "anyOf": [
    {
      "type": "object",
      "required": ["presets"],
      "additionalProperties": false,
      "properties": {
        "workflow": {
          "$ref": "#/$defs/workflow"
        },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "activePreset": { "type": "string", "minLength": 1 },
            "defaultLane": { "type": ["string", "null"], "minLength": 1 },
            "laneSelection": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "enum": ["manual", "suggest", "auto"]
                }
              }
            },
            "subagentExecution": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "enum": ["manual", "suggest", "auto"],
                  "default": "suggest"
                }
              }
            },
            "contextCompression": {
              "$ref": "#/$defs/contextCompression"
            },
            "commandPrefix": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$" },
            "commands": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "status": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$" },
                    "aliases": {
                      "type": "array",
                      "items": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$" }
                    }
                  }
                },
                "use": { "$ref": "#/$defs/commandEntry" },
                "disable": { "$ref": "#/$defs/commandEntry" },
                "sync": { "$ref": "#/$defs/commandEntry" },
                "doctor": { "$ref": "#/$defs/commandEntry" }
              }
            },
            "superpowersCompatibility": { "$ref": "#/$defs/compatibility" }
          }
        },
        "sourcePresets": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "$ref": "#/$defs/sourcePreset"
          }
        },
        "compressionPresets": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "$ref": "#/$defs/compressionPreset"
          }
        },
        "contextProviders": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "$ref": "#/$defs/contextProvider"
          }
        },
        "authority": {
          "$ref": "#/$defs/authority"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "policyRules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/policyRule"
          }
        },
        "profiles": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "object",
            "required": ["model"],
            "additionalProperties": false,
            "properties": {
              "model": { "type": "string", "minLength": 1 },
              "variant": { "type": "string", "minLength": 1 },
              "effort": { "enum": ["fast", "balanced", "deep", "max"] },
              "codexFast": { "type": "boolean" },
              "temperature": { "type": "number" }
            }
          }
        },
        "lanes": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "object",
            "required": ["label", "routes", "defaultRoute"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 },
              "routes": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1
                },
                "additionalProperties": { "type": "string", "minLength": 1 }
              },
              "defaultRoute": { "type": "string", "minLength": 1 }
            }
          }
        },
        "presets": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "object",
            "required": ["label", "short", "routes", "defaultRoute"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "short": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$" },
              "description": { "type": "string", "minLength": 1 },
              "extends": { "type": "string", "minLength": 1 },
              "profiles": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1
                },
                "additionalProperties": {
                  "type": "object",
                  "required": ["model"],
                  "additionalProperties": false,
                  "properties": {
                    "model": { "type": "string", "minLength": 1 },
                    "variant": { "type": "string", "minLength": 1 },
                    "effort": { "enum": ["fast", "balanced", "deep", "max"] },
                    "codexFast": { "type": "boolean" },
                    "temperature": { "type": "number" }
                  }
                }
              },
              "usesLanes": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "defaultLane": { "type": "string", "minLength": 1 },
              "sourcePreset": { "type": "string", "minLength": 1 },
              "sourceRoutes": {
                "$ref": "#/$defs/sourceRoutes"
              },
              "routes": {
                "$ref": "#/$defs/routes"
              },
              "defaultRoute": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["profiles", "defaultRoute"],
      "additionalProperties": false,
      "properties": {
        "workflow": {
          "$ref": "#/$defs/workflow"
        },
        "profiles": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "$ref": "#/$defs/profile"
          }
        },
        "routes": {
          "$ref": "#/$defs/routes"
        },
        "defaultRoute": { "type": "string", "minLength": 1 },
        "superpowersCompatibility": { "$ref": "#/$defs/compatibility" }
      }
    }
  ],
  "$defs": {
    "profile": {
      "type": "object",
      "required": ["model"],
      "additionalProperties": false,
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "variant": { "type": "string", "minLength": 1 },
        "effort": { "enum": ["fast", "balanced", "deep", "max"] },
        "codexFast": { "type": "boolean" },
        "temperature": { "type": "number" }
      }
    },
    "routes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "sourceRoutes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^(phase\\.(brainstorm|plan|execute|review|verify|visual|web-test)|intent\\..+)$"
      },
      "patternProperties": {
        "^phase\\.(brainstorm|plan|execute|review|verify|visual|web-test)$": {
          "enum": ["superpowers", "gstack"]
        },
        "^intent\\..+$": {
          "$ref": "#/$defs/workflowSourceKind"
        }
      },
      "additionalProperties": false
    },
    "workflow": {
      "anyOf": [
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "superpowers" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "intents"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "direct" },
            "intents": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z0-9-]+$"
              },
              "additionalProperties": {
                "$ref": "#/$defs/directIntent"
              }
            }
          }
        }
      ]
    },
    "directIntent": {
      "type": "object",
      "required": ["label"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "sourcePreset": {
      "type": "object",
      "required": ["routes"],
      "additionalProperties": false,
      "properties": {
        "routes": {
          "$ref": "#/$defs/sourceRoutes"
        }
      }
    },
    "contextCompressionMode": {
      "enum": ["manual", "suggest", "auto"]
    },
    "contextCompressionEngine": {
      "enum": ["builtin", "external", "hybrid"]
    },
    "contextInlineLevel": {
      "enum": ["minimal", "standard", "full"]
    },
    "contextCompressionMoments": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subagentHandoff": { "type": "boolean" },
        "planCheckpoint": { "type": "boolean" },
        "reviewCheckpoint": { "type": "boolean" },
        "verificationCheckpoint": { "type": "boolean" },
        "sessionResume": { "type": "boolean" },
        "sourceSwitch": { "type": "boolean" },
        "branchIntegration": { "type": "boolean" }
      }
    },
    "contextCompressionSafety": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowConditional": { "type": "boolean" },
        "requireFreshVerification": { "type": "boolean" }
      }
    },
    "contextCompression": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preset": { "type": ["string", "null"], "minLength": 1 },
        "mode": { "$ref": "#/$defs/contextCompressionMode" },
        "engine": { "$ref": "#/$defs/contextCompressionEngine" },
        "inlineLevel": { "$ref": "#/$defs/contextInlineLevel" },
        "moments": { "$ref": "#/$defs/contextCompressionMoments" },
        "safety": { "$ref": "#/$defs/contextCompressionSafety" }
      }
    },
    "compressionPreset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "$ref": "#/$defs/contextCompressionMode" },
        "engine": { "$ref": "#/$defs/contextCompressionEngine" },
        "inlineLevel": { "$ref": "#/$defs/contextInlineLevel" },
        "moments": { "$ref": "#/$defs/contextCompressionMoments" },
        "safety": { "$ref": "#/$defs/contextCompressionSafety" }
      }
    },
    "contextProviderCapability": {
      "enum": ["recall", "search", "summarize", "pack", "status"]
    },
    "contextProvider": {
      "oneOf": [
        { "$ref": "#/$defs/fileContextProvider" },
        { "$ref": "#/$defs/cliContextProvider" },
        { "$ref": "#/$defs/mcpContextProvider" }
      ]
    },
    "evidenceDetectedPath": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "suggestedTags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "detectedPaths": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceDetectedPath" }
        },
        "notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "authorityWorkloadMapping": {
      "type": "object",
      "required": ["path", "workloadTags"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "workloadTags": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workloadMappings": {
          "type": "array",
          "items": { "$ref": "#/$defs/authorityWorkloadMapping" }
        },
        "policyRules": {
          "type": "array",
          "items": { "$ref": "#/$defs/policyRule" }
        }
      }
    },
    "policySelector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "lifecycleStage": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "bootstrap",
              "design",
              "prepare_workspace",
              "plan",
              "execute_task",
              "review",
              "verify",
              "integrate_branch",
              "checkpoint",
              "resume"
            ]
          }
        },
        "workflowSource": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/workflowSourceKind" }
        },
        "agentRole": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["primary", "subagent"] }
        },
        "workloadTags": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "modalityRequirements": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "policyModel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preferredProfiles": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "effort": { "enum": ["fast", "balanced", "deep", "max", null] },
        "preferWindowClass": { "enum": ["small", "medium", "large", null] },
        "requiredCapabilities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "policyContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "compressionPreset": { "type": ["string", "null"], "minLength": 1 },
        "packetFirst": { "type": ["boolean", "null"] },
        "maxCharsBeforeCompression": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "policyTool": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowedSkillTags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "allowedMcpTags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "blockedToolTags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "policyFamilies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modelPolicy": { "$ref": "#/$defs/policyModel" },
        "contextPolicy": { "$ref": "#/$defs/policyContext" },
        "toolPolicy": { "$ref": "#/$defs/policyTool" }
      }
    },
    "policyRule": {
      "type": "object",
      "required": ["selector", "policy"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "selector": { "$ref": "#/$defs/policySelector" },
        "policy": { "$ref": "#/$defs/policyFamilies" }
      }
    },
    "fileContextProvider": {
      "type": "object",
      "required": ["kind", "enabled", "root", "capabilities"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "file" },
        "enabled": { "type": "boolean" },
        "root": { "type": "string", "minLength": 1 },
        "capabilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/contextProviderCapability" }
        }
      }
    },
    "cliContextProvider": {
      "type": "object",
      "required": ["kind", "enabled", "command", "capabilities"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "cli" },
        "enabled": { "type": "boolean" },
        "command": { "type": "string", "minLength": 1 },
        "args": {
          "type": "array",
          "items": { "type": "string" }
        },
        "capabilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/contextProviderCapability" }
        }
      }
    },
    "mcpContextProvider": {
      "type": "object",
      "required": ["kind", "enabled", "command", "capabilities"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "mcp" },
        "enabled": { "type": "boolean" },
        "command": { "type": "string", "minLength": 1 },
        "args": {
          "type": "array",
          "items": { "type": "string" }
        },
        "capabilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/contextProviderCapability" }
        }
      }
    },
    "workflowSourceKind": {
      "enum": ["superpowers", "gstack", "direct"]
    },
    "nonDirectWorkflowSourceKind": {
      "enum": ["superpowers", "gstack"]
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": ["warn", "strict"],
          "default": "warn"
        }
      }
    },
    "commandEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$" },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$" }
        }
      }
    }
  }
}
