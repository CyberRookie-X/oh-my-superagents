{
  "name": "oh-my-superagents",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/plugin.js",
  "exports": {
    ".": "./dist/plugin.js",
    "./plugin": "./dist/plugin.js",
    "./library": "./dist/index.js",
    "./schema": "./schemas/oh-my-superagents.schema.json"
  },
  "bin": {
